# Maa Pitambara Pharmacy — copy to .env and fill in real values.
# Never commit .env.

# --- Database -------------------------------------------------------------
# Local dev against a Postgres 16 instance. With docker compose, the app
# container gets this composed from POSTGRES_* below instead.
DATABASE_URL="postgresql://pharmacy:pharmacy@localhost:5432/pharmacy?schema=public"

# Used only by docker-compose.yml to provision the db container.
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy
POSTGRES_DB=pharmacy

# --- Auth -----------------------------------------------------------------
# Public URL the reverse proxy serves (https:// in production).
NEXTAUTH_URL="http://localhost:3000"
# Generate both with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""
# Sliding idle timeout for a signed-in session.
SESSION_IDLE_TIMEOUT_MINUTES=15

# --- Backups --------------------------------------------------------------
# AES-256-GCM key for encrypting exports. 32 bytes, hex or base64:
#   openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""
# Shared secret for the unattended backup cron endpoint:
#   openssl rand -base64 32
BACKUP_CRON_SECRET=""
# Where encrypted backup files are written (defaults to ./backups).
BACKUP_LOCAL_DIR="./backups"

# --- Uploaded documents ---------------------------------------------------
# Both stored outside public/, served only via authenticated files routes.
PRESCRIPTION_STORAGE_DIR="./storage/prescriptions"
# Purchase documents: GRN supplier invoices, PO quotations, and a
# supplier's visiting card / cancelled cheque.
PURCHASE_INVOICE_STORAGE_DIR="./storage/purchase-invoices"
# Product pack photos attached to an item.
ITEM_PHOTO_STORAGE_DIR="./storage/item-photos"

# --- Clock ----------------------------------------------------------------
# The pharmacy's own timezone. Every date in the app is a local calendar fact
# — the business day, the GST period, the month in an invoice number — so the
# server has to think in IST regardless of where it runs. The app pins this at
# startup (see src/instrumentation.ts), so it is correct by default on a cloud
# host whose clock is UTC; override only for a shop in another zone.
PHARMACY_TIMEZONE="Asia/Kolkata"

# --- Object storage for uploads (cloud/serverless hosting) ----------------
# Leave ATTACHMENT_S3_BUCKET empty to keep using the local directories above,
# which is right for the in-shop machine.
#
# Set it on any host with a read-only or ephemeral filesystem (Vercel, Lambda,
# Cloud Run). There, local writes are silently discarded between requests, and
# prescriptions are a record we must retain for three years — so on such a
# host this is required, not optional. Works with any S3-compatible provider:
# Cloudflare R2, AWS S3, Backblaze B2, MinIO.
#
# The bucket must NOT be public: files are still served only through the
# authenticated /api/files/... routes, which check the requesting tenant.
ATTACHMENT_S3_BUCKET=""
# Omit for AWS S3; required for R2/B2/MinIO. e.g.
# https://<accountid>.r2.cloudflarestorage.com
ATTACHMENT_S3_ENDPOINT=""
# "auto" suits R2; set a real region for AWS (e.g. ap-south-1 for Mumbai).
ATTACHMENT_S3_REGION="auto"
# Omit both to fall back to the SDK's credential chain (instance role).
ATTACHMENT_S3_ACCESS_KEY_ID=""
ATTACHMENT_S3_SECRET_ACCESS_KEY=""

# --- Photo field extraction (Claude vision) — optional ------------------
# Powers the "Fill from photo" buttons on the item and supplier forms.
# Unset: the buttons report "not configured" instead of failing.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Seeding --------------------------------------------------------------
# The owner account is seeded with the pharmacy's registered email
# (aamitgs@gmail.com). Set a real password here before running db:seed;
# otherwise it falls back to the documented default, which must be changed
# at first login.
SEED_OWNER_PASSWORD=""

# --- WhatsApp delivery (Gupshup) — optional -------------------------------
# Unset: the "Send via WhatsApp" buttons report "not configured".
GUPSHUP_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_APP_NAME=""

# --- Email delivery (SMTP) — optional -------------------------------------
# Unset: the "Send via Email" button opens the message in the machine's own
# mail client instead. A Gmail account needs an app password, not the
# account password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- E-invoice / e-way bill (GSP) — optional ------------------------------
# Unset: IRN / e-way bill generation reports "not configured".
GSP_BASE_URL=""
GSP_API_KEY=""
GSP_SELLER_GSTIN="09APFPS2581C1ZT"

# --- SMS (optional) -------------------------------------------------------
# India requires DLT registration before any commercial SMS will be
# delivered: register the business on an operator's DLT portal, get a
# 6-character header, and register each template from
# src/lib/sms/templates.ts verbatim. See the README.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
SMS_TEMPLATE_ID_RECEIPT=
SMS_TEMPLATE_ID_RECEIPT_LINK=
SMS_TEMPLATE_ID_REMINDER=

# Absolute base URL used in the customer's bill link. Falls back to
# NEXTAUTH_URL. Must be the address customers can actually reach.
PUBLIC_BASE_URL=
